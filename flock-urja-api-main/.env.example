# Urja Meter Ops Upstream Configuration
PORTAL_BASE_URL=https://urja-ops.flockenergy.tech
PORTAL_USERNAME=operator@urja.local
PORTAL_PASSWORD=your_password_here

# Service Settings
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
DEBUG=false
# Required for every /api/v1 request; replace with a unique random secret.
API_ACCESS_TOKEN=replace-with-a-unique-random-secret-at-least-16-characters
# Shared by workers on this host for forced-sync cooldown coordination.
SYNC_STATE_DB_PATH=.sync_state.sqlite3

# Cache & Sync Settings
CACHE_TTL_SECONDS=900
AUTO_SYNC_ON_STARTUP=true
FORCED_SYNC_COOLDOWN_SECONDS=60

# Request Settings
UPSTREAM_TIMEOUT_SECONDS=15.0
UPSTREAM_MAX_RETRIES=3
